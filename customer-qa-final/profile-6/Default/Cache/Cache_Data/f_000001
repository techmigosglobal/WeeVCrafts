:root {
  --paper: #f6f0e6;
  --surface: #fffdf8;
  --surface-2: #efe7da;
  --ink: #2d201b;
  --muted: #756a61;
  --line: #dfd3c5;
  --forest: #124534;
  --forest-2: #0d3529;
  --terracotta: #b6533f;
  --gold: #b88638;
  --serif: "Playfair Display", Georgia, serif;
  --sans: "DM Sans", Arial, sans-serif;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--sans); font-size: 14px; line-height: 1.5; }
body, button, input, select { font-family: var(--sans); }
button, a { -webkit-tap-highlight-color: transparent; }
a { color: inherit; text-decoration: none; }
button { border: 0; cursor: pointer; }
img { display: block; max-width: 100%; }
.container { width: calc(100% - 48px); max-width: 1240px; margin-inline: auto; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
.material-symbols-outlined { font-size: 18px; line-height: 1; vertical-align: middle; font-variation-settings: "FILL" 0, "wght" 300, "GRAD" 0, "opsz" 24; }
.preview-bar { display: none; }

.utility-bar { background: var(--forest-2); color: #f7eee3; font-size: 11px; letter-spacing: .02em; }
.utility-inner { min-height: 30px; display: flex; align-items: center; justify-content: space-between; }
.utility-links { display: flex; align-items: center; gap: 12px; opacity: .82; }
.utility-links i { display: inline-block; width: 3px; height: 3px; border-radius: 50%; background: #c9a779; }
.site-header { position: relative; background: var(--surface); border-bottom: 1px solid var(--line); }
.header-main { min-height: 82px; display: grid; grid-template-columns: auto auto auto minmax(220px, 1fr) auto; align-items: center; gap: 26px; }
.wordmark { display: inline-flex; align-items: center; gap: 10px; color: var(--forest); }
.wordmark-mark { display: grid; place-items: center; width: 36px; height: 36px; border: 1px solid var(--forest); border-radius: 50%; font-family: var(--serif); font-size: 22px; font-weight: 600; }
.wordmark strong { display: block; font: 600 21px/1 var(--serif); letter-spacing: -.03em; }
.wordmark small { display: block; margin-top: 4px; color: var(--muted); font-size: 9px; letter-spacing: .04em; }
.location { display: inline-flex; align-items: center; gap: 8px; padding: 0; color: var(--ink); background: transparent; text-align: left; }
.location > .material-symbols-outlined { color: var(--terracotta); font-size: 23px; }
.location small { color: var(--muted); font-size: 10px; line-height: 1.45; }
.location b { color: var(--ink); font-weight: 600; }
.global-search { display: flex; height: 42px; border: 1px solid #cfc1b1; background: #fbf8f2; }
.global-search input { flex: 1; min-width: 0; border: 0; outline: 0; padding: 0 14px; color: var(--ink); background: transparent; font-size: 12px; }
.global-search button { display: grid; place-items: center; width: 45px; color: var(--surface); background: var(--terracotta); }
.global-search button .material-symbols-outlined { font-size: 21px; }
.header-actions { display: flex; align-items: center; gap: 18px; }
.header-actions a { display: inline-flex; align-items: center; gap: 4px; color: var(--ink); font-size: 10px; }
.header-actions a > span:first-child { color: var(--forest); font-size: 21px; }
.header-actions a > span:last-child { display: flex; align-items: center; gap: 4px; }
.header-actions em { display: inline-grid; place-items: center; min-width: 15px; height: 15px; padding-inline: 3px; border-radius: 50%; color: #fff; background: var(--terracotta); font-size: 9px; font-style: normal; }
.icon-button, .menu-toggle, .mobile-menu-button { display: none; }
.nav-row { min-height: 42px; display: flex; align-items: center; border-top: 1px solid #eee7dc; }
.primary-nav, .secondary-nav { display: flex; align-items: center; gap: 25px; }
.primary-nav a, .secondary-nav a { display: inline-flex; align-items: center; gap: 3px; color: #4a3b32; font-size: 11px; font-weight: 600; }
.primary-nav .material-symbols-outlined { font-size: 15px; }
.secondary-nav { margin-left: auto; gap: 19px; }
.secondary-nav a { color: var(--muted); font-weight: 500; }
.mobile-menu { display: none; }

h1, h2, h3, p { margin-top: 0; }
h1, h2, h3 { color: var(--ink); }
h1, h2 { font-family: var(--serif); font-weight: 500; letter-spacing: -.03em; }
h1 em, h2 em { color: var(--terracotta); font-style: italic; }
.eyebrow { margin-bottom: 8px; color: var(--terracotta); font-size: 10px; font-weight: 700; letter-spacing: .17em; text-transform: uppercase; }
.breadcrumb { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 27px; color: var(--muted); font-size: 11px; }
.breadcrumb a:last-child { color: var(--ink); }
.breadcrumb span { color: #b29e8b; }
.primary-button, .outline-button { display: inline-flex; justify-content: center; align-items: center; gap: 8px; min-height: 40px; padding: 0 17px; border: 1px solid var(--terracotta); font-size: 11px; font-weight: 700; letter-spacing: .01em; transition: transform .15s, background .15s; }
.primary-button { color: #fff; background: var(--terracotta); }
.outline-button { color: var(--terracotta); background: transparent; }
.primary-button:hover, .outline-button:hover { transform: translateY(-1px); }
.primary-button .material-symbols-outlined, .outline-button .material-symbols-outlined, .text-link .material-symbols-outlined { font-size: 16px; }
.text-link { display: inline-flex; align-items: center; gap: 6px; color: var(--terracotta); font-size: 11px; font-weight: 700; }
.inverse-link { color: #ead5b9; }
.text-button { padding: 0; color: var(--terracotta); background: transparent; font-size: 11px; font-weight: 700; }
.full { width: 100%; }
.badge { display: inline-flex; align-items: center; min-height: 20px; padding: 0 8px; color: var(--terracotta); background: #f5e1d5; font-size: 9px; font-weight: 700; letter-spacing: .03em; }
mark { padding: 3px 7px; color: var(--terracotta); background: #f7e4d9; font-size: 9px; font-weight: 700; }
.section { padding-top: 66px; }
.section-head { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 24px; }
.section-head h2 { margin-bottom: 4px; font-size: 31px; }
.section-head p:not(.eyebrow) { margin-bottom: 0; color: var(--muted); font-size: 12px; }

.hero { display: grid; grid-template-columns: .92fr 1.22fr .23fr; min-height: 475px; margin-top: 22px; background: #eadfd0; overflow: hidden; }
.hero-copy { display: flex; flex-direction: column; justify-content: center; padding: 42px 26px 38px 38px; }
.hero-copy h1 { max-width: 470px; margin-bottom: 19px; font-size: clamp(38px, 4.6vw, 62px); line-height: .99; }
.hero-copy > p:not(.eyebrow) { max-width: 405px; margin-bottom: 26px; color: #5f5146; font-size: 13px; }
.hero-copy .primary-button { align-self: start; }
.hero-proof { display: flex; flex-wrap: wrap; gap: 9px 16px; margin-top: 26px; color: #78695b; font-size: 9px; }
.hero-proof b { color: var(--terracotta); }
.hero-image { position: relative; min-height: 475px; overflow: hidden; }
.hero-image img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
.hero-note { position: absolute; left: 20px; bottom: 24px; color: #fff; font: italic 20px/1.15 var(--serif); text-shadow: 0 1px 6px #4a2318; }
.hero-note b { color: #f4c9a6; }
.hero-note .material-symbols-outlined { font-size: 17px; }
.hero-aside { display: flex; flex-direction: column; justify-content: space-between; align-items: center; padding: 26px 8px 22px; color: #f5ebde; background: var(--forest); writing-mode: vertical-rl; }
.hero-aside span { font: 12px/1.3 var(--serif); letter-spacing: .03em; }
.hero-aside b { color: #e2b784; }
.hero-aside i { color: #e2b784; font: 30px var(--serif); font-style: normal; }
.category-rail { display: grid; grid-template-columns: repeat(3, 1fr); gap: 13px; margin-top: 28px; }
.category-card { position: relative; display: block; min-height: 142px; overflow: hidden; background: #d5c4af; }
.category-card img { width: 100%; height: 100%; min-height: 142px; object-fit: cover; }
.category-card > span { position: absolute; inset: auto 0 0; display: flex; flex-direction: column; padding: 19px 18px 16px; color: #fff; background: linear-gradient(transparent, rgba(16, 24, 19, .82)); }
.category-card strong { font: 20px var(--serif); }
.category-card small { max-width: 240px; margin: 2px 0 8px; font-size: 10px; }
.category-card b { display: inline-flex; align-items: center; gap: 4px; font-size: 10px; }
.category-card b .material-symbols-outlined { font-size: 14px; }
.offers-rail { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; margin-top: 20px; background: var(--line); border-block: 1px solid var(--line); }
.offers-rail > div { display: grid; grid-template-columns: 42px 1fr; gap: 10px; align-items: center; padding: 18px 18px; background: #faf4eb; }
.offer-icon { display: grid; place-items: center; width: 34px; height: 34px; border: 1px solid #c98e75; border-radius: 50%; color: var(--terracotta); font: 18px var(--serif); }
.offers-rail b { font: 600 13px/1.2 var(--serif); }
.offers-rail strong { color: var(--terracotta); font-weight: 600; }
.offers-rail small { grid-column: 2; color: var(--muted); font-size: 9px; }
.product-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px 14px; }
.product-grid--six { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 13px; }
.product-grid--five { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 15px; }
.product-grid--four { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.product-card { min-width: 0; background: transparent; }
.product-media { position: relative; aspect-ratio: 1 / 1.08; overflow: hidden; background: #e8dece; }
.product-media img { width: 100%; height: 100%; object-fit: cover; transition: transform .3s; }
.product-card:hover .product-media img { transform: scale(1.04); }
.heart, .gallery-heart { position: absolute; top: 9px; right: 9px; display: grid; place-items: center; width: 29px; height: 29px; border-radius: 50%; color: var(--terracotta); background: rgba(255, 253, 248, .9); }
.heart .material-symbols-outlined, .gallery-heart .material-symbols-outlined { font-size: 17px; }
.product-media > .badge { position: absolute; top: 10px; left: 10px; }
.product-copy { padding: 11px 1px 0; }
.product-copy h3 { min-height: 38px; margin-bottom: 3px; font: 600 13px/1.3 var(--serif); }
.product-copy h3 a:hover { color: var(--terracotta); }
.product-copy p { margin-bottom: 6px; color: var(--muted); font-size: 10px; }
.rating, .stars { display: flex; align-items: center; gap: 3px; color: #80633a; font-size: 10px; }
.rating .material-symbols-outlined, .stars .material-symbols-outlined { color: var(--gold); font-size: 14px; font-variation-settings: "FILL" 1, "wght" 400, "GRAD" 0, "opsz" 20; }
.price { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
.price strong { color: var(--terracotta); font-size: 14px; }
.price del { color: #95867a; font-size: 10px; }
.price mark { padding: 2px 4px; font-size: 8px; }
.add-button { width: 100%; min-height: 32px; margin-top: 11px; padding-inline: 7px; font-size: 10px; }
.add-button .material-symbols-outlined { font-size: 14px; }
.seller-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
.seller-card { position: relative; min-height: 257px; overflow: hidden; background: #b6a08e; }
.seller-card > img { width: 100%; height: 100%; object-fit: cover; }
.seller-card::after { position: absolute; inset: 35% 0 0; content: ""; background: linear-gradient(transparent, rgba(16, 24, 19, .88)); }
.seller-card-copy { position: absolute; z-index: 1; right: 15px; bottom: 14px; left: 15px; display: flex; flex-direction: column; color: #fff; }
.seller-card-copy b { font: 19px var(--serif); }
.seller-card-copy small { margin-bottom: 7px; color: #ecd8c3; font-size: 9px; }
.seller-card-copy em { display: -webkit-box; max-height: 31px; overflow: hidden; color: #f3e9dd; font-size: 9px; font-style: normal; line-height: 1.3; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.seller-card-copy strong { display: inline-flex; align-items: center; gap: 4px; margin-top: 9px; font-size: 10px; }
.seller-card-copy .material-symbols-outlined { font-size: 14px; }
.maker-banner, .seller-callout { display: grid; grid-template-columns: 1fr .7fr; align-items: stretch; min-height: 275px; margin-top: 70px; overflow: hidden; background: var(--forest); }
.maker-banner > div, .seller-callout > div { padding: 44px 48px; color: #f3e9db; }
.maker-banner h2, .seller-callout h2 { color: #f4ecdf; font-size: 34px; }
.maker-banner p:not(.eyebrow), .seller-callout p:not(.eyebrow) { max-width: 480px; color: #c5d0c6; font-size: 12px; }
.maker-banner img, .seller-callout img { width: 100%; height: 100%; min-height: 275px; object-fit: cover; }
.maker-banner .outline-button { margin-top: 10px; border-color: #d3b18e; color: #f3dbbc; }
.collection-grid { display: grid; grid-template-columns: 1.25fr 1fr 1fr; gap: 14px; }
.collection-card { position: relative; display: block; height: 225px; overflow: hidden; background: #d5c2ae; }
.collection-card--large { height: 280px; }
.collection-card img { width: 100%; height: 100%; object-fit: cover; }
.collection-card::after { position: absolute; inset: 30% 0 0; content: ""; background: linear-gradient(transparent, rgba(16, 24, 19, .84)); }
.collection-card > span { position: absolute; z-index: 1; right: 20px; bottom: 18px; left: 20px; display: flex; flex-direction: column; color: #fff; }
.collection-card small { color: #efd8bd; font-size: 9px; }
.collection-card strong { font: 24px var(--serif); }
.collection-card b { display: inline-flex; align-items: center; gap: 5px; margin-top: 6px; font-size: 10px; }
.collection-card b .material-symbols-outlined { font-size: 15px; }
.world-strip, .international-banner { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-top: 70px; padding: 25px 35px; color: #f7ede1; background: var(--forest); overflow: hidden; }
.world-strip > div { flex: 1; }
.world-strip .material-symbols-outlined, .international-banner > div > .material-symbols-outlined { color: #d3a472; font-size: 35px; }
.world-strip h2, .international-banner h2 { margin: 5px 0; color: #f8eee3; font-size: 25px; }
.world-strip p, .international-banner p:not(.eyebrow) { color: #c8d2c8; font-size: 11px; }
.world-strip a, .international-banner a:not(.outline-button) { color: #e4c190; font-size: 10px; font-weight: 700; }
.world-strip img { width: 105px; height: 105px; object-fit: cover; border: 4px solid #e9d5bb; }

.page-intro { padding-top: 34px; padding-bottom: 33px; }
.page-intro h1 { margin-bottom: 7px; font-size: 44px; }
.page-intro > p:not(.eyebrow) { max-width: 615px; margin-bottom: 0; color: var(--muted); font-size: 13px; }
.page-intro > p + p { margin-top: 4px; }
.categories-intro, .listing-intro { background: radial-gradient(circle at 90% 40%, #ebd8c7, transparent 37%); }
.category-layout { display: grid; grid-template-columns: 205px minmax(0, 1fr); gap: 28px; align-items: start; }
.category-sidebar { position: sticky; top: 15px; padding: 21px 17px; background: var(--surface); border: 1px solid var(--line); }
.category-sidebar h2 { margin-bottom: 17px; font-size: 21px; }
.category-sidebar > a { display: flex; justify-content: space-between; padding: 10px 0; border-top: 1px solid #eee5da; color: var(--muted); font-size: 11px; }
.category-sidebar > a.active { color: var(--terracotta); font-weight: 700; }
.category-sidebar > a span { color: #a99888; font-size: 10px; }
.sidebar-note { display: flex; flex-direction: column; gap: 5px; margin-top: 23px; padding-top: 18px; border-top: 1px solid var(--line); }
.sidebar-note .material-symbols-outlined { color: var(--terracotta); }
.sidebar-note b { font-size: 11px; }
.sidebar-note small { color: var(--muted); font-size: 9px; }
.category-feature { display: grid; grid-template-columns: .9fr 1.1fr; min-height: 220px; margin-bottom: 20px; overflow: hidden; background: var(--forest); }
.category-feature img { width: 100%; height: 100%; object-fit: cover; }
.category-feature > div { padding: 33px; color: #e9ded0; }
.category-feature h2 { color: #fff3e5; font-size: 29px; }
.category-feature p:not(.eyebrow) { color: #c9d2c8; font-size: 11px; }
.category-feature .primary-button { margin-top: 8px; }
.category-card-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
.category-card-grid .category-card { min-height: 150px; }
.category-card-grid .category-card img { min-height: 150px; }
.subcategories { display: grid; grid-template-columns: 1fr 1fr; gap: 13px; margin-top: 23px; }
.subcat-panel { padding: 26px; background: #eadfd1; }
.subcat-panel h2 { margin-bottom: 17px; font-size: 26px; }
.subcat-links { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; }
.subcat-links a { display: flex; flex-direction: column; padding: 12px; background: rgba(255, 253, 248, .65); }
.subcat-links b { font: 13px var(--serif); }
.subcat-links small { margin-top: 4px; color: var(--muted); font-size: 9px; }
.subcat-panel--dark { color: #eee5d9; background: var(--forest); }
.subcat-panel--dark h2 { color: #fff4e5; }
.subcat-panel--dark p:not(.eyebrow) { color: #c8d3c9; font-size: 11px; }
.category-collections { padding-bottom: 10px; }

.listing-layout { display: grid; grid-template-columns: 205px minmax(0, 1fr); gap: 25px; align-items: start; }
.filter-sidebar { padding: 18px 16px; background: var(--surface); border: 1px solid var(--line); }
.filter-head { display: flex; justify-content: space-between; align-items: center; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
.filter-head h2 { margin: 0; font-size: 21px; }
.filter-head a { color: var(--terracotta); font-size: 10px; font-weight: 700; }
.filter-sidebar details { padding: 14px 0; border-bottom: 1px solid #eee5da; }
.filter-sidebar summary { display: flex; justify-content: space-between; list-style: none; cursor: pointer; font-size: 11px; font-weight: 700; }
.filter-sidebar summary::-webkit-details-marker { display: none; }
.filter-sidebar summary .material-symbols-outlined { font-size: 14px; }
.filter-sidebar label { display: flex; align-items: center; gap: 7px; margin-top: 10px; color: var(--muted); font-size: 10px; }
.filter-sidebar label span { margin-left: auto; color: #a99a8d; }
.filter-sidebar input { accent-color: var(--terracotta); }
.results-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 18px; min-height: 39px; margin-bottom: 14px; padding-bottom: 11px; border-bottom: 1px solid var(--line); }
.results-toolbar > div { display: flex; align-items: center; gap: 17px; }
.results-toolbar b { font-family: var(--serif); font-size: 18px; font-weight: 500; }
.filter-chips { display: flex; gap: 6px; }
.filter-chips button { padding: 5px 7px; color: var(--terracotta); background: #f3e0d5; font-size: 9px; }
.filter-chips button span { margin-left: 5px; }
.results-toolbar label, .seller-tabs label { display: inline-flex; align-items: center; gap: 7px; color: var(--muted); font-size: 10px; }
select { min-height: 31px; padding: 0 26px 0 8px; border: 1px solid var(--line); color: var(--ink); background: var(--surface); font-size: 10px; }
.listing-banner { display: grid; grid-template-columns: 1fr 180px; min-height: 150px; margin-bottom: 20px; overflow: hidden; background: #e4d4c3; }
.listing-banner > div { padding: 22px 25px; }
.listing-banner h2 { margin-bottom: 5px; font-size: 25px; }
.listing-banner p:not(.eyebrow) { margin-bottom: 7px; color: var(--muted); font-size: 10px; }
.listing-banner a { color: var(--terracotta); font-size: 10px; font-weight: 700; }
.listing-banner img { width: 100%; height: 100%; object-fit: cover; }
.pagination { display: flex; justify-content: center; align-items: center; gap: 5px; margin: 32px 0 2px; }
.pagination a, .pagination span { display: grid; place-items: center; min-width: 28px; height: 28px; color: var(--muted); font-size: 10px; }
.pagination a.active { color: #fff; background: var(--terracotta); }
.pagination .material-symbols-outlined { font-size: 16px; }
.international-banner { margin-top: 51px; padding: 22px 28px; }
.international-banner > div { display: flex; align-items: center; gap: 17px; }
.international-banner h2 { font-size: 23px; }
.international-banner .outline-button { border-color: #d3b18e; color: #f0d7b5; }

.product-detail { padding-top: 29px; }
.detail-grid { display: grid; grid-template-columns: 1fr .85fr; gap: 42px; align-items: start; }
.gallery { display: grid; grid-template-columns: 70px minmax(0, 1fr); gap: 12px; }
.thumbs { display: flex; flex-direction: column; gap: 10px; }
.thumbs button { padding: 0; border: 1px solid transparent; background: transparent; }
.thumbs button:first-child { border-color: var(--terracotta); }
.thumbs img { width: 68px; height: 74px; object-fit: cover; }
.gallery-main { position: relative; aspect-ratio: 1 / 1.12; overflow: hidden; background: #dfcfbc; }
.gallery-main > img { width: 100%; height: 100%; object-fit: cover; }
.gallery-main .gallery-heart { width: 36px; height: 36px; }
.gallery-caption { grid-column: 2; margin-top: 8px; color: var(--muted); font-size: 10px; }
.detail-copy h1 { margin: 12px 0 5px; font-size: 35px; line-height: 1.08; }
.detail-copy .lead { color: var(--muted); font: italic 15px var(--serif); }
.detail-copy > .stars { margin: 17px 0; }
.detail-copy > .stars > span:last-child { margin-left: 6px; color: var(--muted); font-size: 11px; }
.seller-line { display: flex; align-items: center; gap: 11px; padding: 12px 0; border-block: 1px solid var(--line); font-size: 11px; font-weight: 700; }
.seller-line img { width: 39px; height: 39px; border-radius: 50%; object-fit: cover; }
.seller-line > span:nth-child(2) { display: flex; flex: 1; flex-direction: column; }
.seller-line small { display: flex; align-items: center; margin-top: 3px; color: var(--muted); font-size: 9px; font-weight: 400; }
.seller-line small .material-symbols-outlined { font-size: 13px; }
