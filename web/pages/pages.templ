package pages

import (
  "github.com/wecratfs/commerce/internal/web/viewmodels"
  "github.com/wecratfs/commerce/web/components"
)

templ Document(p viewmodels.CustomerPage) {
  <!doctype html>
  <html lang="en">
    <head>
      <meta charset="utf-8"/>
      <meta name="viewport" content="width=device-width, initial-scale=1"/>
      <meta name="description" content={ p.Description }/>
      <meta name="robots" content="noindex,nofollow"/>
      <title>{ p.Title } - WeeVCrafts</title>
      <link rel="preconnect" href="https://fonts.googleapis.com"/>
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
      <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&amp;family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,300,0,0&amp;family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&amp;display=swap" rel="stylesheet"/>
      <link rel="stylesheet" href="/assets/css/app.css"/>
      <link rel="stylesheet" href="/assets/css/theme.css"/>
      <link rel="stylesheet" href="/assets/css/utility.css"/>
      <style>[x-cloak]{display:none!important}</style>
      <script defer src="/assets/js/htmx.min.js"></script>
      <script defer src="/assets/js/alpine.min.js"></script>
    </head>
    <body>
      @components.Header(p)
      <main id="page">{ children... }</main>
      @components.Footer(p)
    </body>
  </html>
}

templ Breadcrumb(items ...string) {
  <nav class="breadcrumb" aria-label="Breadcrumb">
    for i, item := range items {
      if i > 0 {
        <span>/</span>
      }
      <a href="#">{ item }</a>
    }
  </nav>
}

templ SectionHeading(kicker, title, copy string) {
  <div class="section-head"><div><p class="eyebrow">{ kicker }</p><h2>{ title }</h2><p>{ copy }</p></div><a class="text-link" href="/products">View all <span class="material-symbols-outlined">arrow_forward</span></a></div>
}

templ ProductCards(products []viewmodels.Product, showAction bool) {
  for _, product := range products {
    @components.ProductCard(product, showAction)
  }
}

templ ListingProducts(products []viewmodels.Product) {
  if len(products) == 0 {
    <div class="empty-state"><span class="material-symbols-outlined">search_off</span><h2>No treasures found</h2><p>Try another search or clear your filters.</p></div>
  } else {
    @ProductCards(products, false)
  }
}

templ SavedProducts(products []viewmodels.Product) {
  for _, product := range products {
    @SavedProduct(product)
  }
}

templ CategoryCards(categories []viewmodels.Category) {
  for _, category := range categories {
    @components.CategoryCard(category)
  }
}

templ SellerCards(sellers []viewmodels.Seller) {
  for _, seller := range sellers {
    <a class="seller-card" href={ "/makers/" + seller.Slug }><img src={ seller.ImageURL } alt={ seller.Name } loading="lazy"/><span class="seller-card-copy"><b>{ seller.Name }</b><small>{ seller.Location }</small><em>{ seller.Description }</em><strong>Explore store <span class="material-symbols-outlined">arrow_forward</span></strong></span></a>
  }
}

templ OrderRows(items []viewmodels.CartItem) {
  for _, item := range items {
    <div class="order-item"><img src={ item.Product.ImageURL } alt={ item.Product.Name }/><div><b>{ item.Product.Name }</b><small>Qty: { item.Quantity } | { item.Product.Location }</small><strong>{ item.Product.Price }</strong></div><a class="outline-button" href={ "/products/" + item.Product.Slug }>View item</a></div>
  }
}

templ OrderDetailRows(items []viewmodels.CartItem) {
  for _, item := range items {
    <article class="order-line"><img src={ item.Product.ImageURL } alt=""/><span><b>{ item.Product.Name }</b><small>Qty: { item.Quantity } | Sold by { item.Product.Seller }</small></span><strong>{ item.Product.Price }</strong></article>
  }
}

templ HistoryRows(orders []viewmodels.Order) {
  for _, order := range orders {
    <article class="order-card compact-order"><header><div><p class="eyebrow">{ order.Status }</p><h2>{ order.Number }</h2><small>Placed on { order.Date } | { order.Payment }</small></div><div><strong>{ order.Total }</strong><span class="status">{ order.Status }</span></div></header><div class="compact-order-item"><img src={ order.Items[0].Product.ImageURL } alt={ order.Items[0].Product.Name }/><span>{ order.Items[0].Product.Name }<small>{ len(order.Items) } item</small></span><a href="/orders/%23WC2504267819">View details <span class="material-symbols-outlined">arrow_forward</span></a></div></article>
  }
}

templ CartRows(items []viewmodels.CartItem) {
  if len(items) == 0 {
    <div class="empty-state"><span class="material-symbols-outlined">shopping_bag</span><h2>Your cart is waiting for something special</h2><p>Browse handmade treasures and bring a little India home.</p><a class="primary-button" href="/products">Continue shopping</a></div>
  } else {
    for _, item := range items {
      <article class="cart-seller"><div class="cart-seller-head"><div><span class="material-symbols-outlined">storefront</span><b>{ item.Product.Seller }</b><small>{ item.Product.Location }</small></div><span class="delivery"><span class="material-symbols-outlined">local_shipping</span> Delivery in { item.Delivery }</span></div><div class="cart-line"><img src={ item.Product.ImageURL } alt={ item.Product.Name }/><div class="cart-line-copy"><span class="badge">{ item.Product.Badge }</span><h2>{ item.Product.Name }</h2><p>Handmade in { item.Product.Location }</p><div class="price"><strong>{ item.Product.Price }</strong><del>{ item.Product.CompareAt }</del></div><div class="cart-line-actions"><span class="quantity-control"><button type="button" hx-post={ "/ui/cart/" + item.Product.Slug } hx-vals='{"delta":"-1"}' hx-select="#page" hx-target="#page">-</button><output>{ item.Quantity }</output><button type="button" hx-post={ "/ui/cart/" + item.Product.Slug } hx-vals='{"delta":"1"}' hx-select="#page" hx-target="#page">+</button></span><button class="text-button" type="button" hx-post={ "/ui/cart/" + item.Product.Slug } hx-vals='{"delta":"-1"}' hx-select="#page" hx-target="#page"><span class="material-symbols-outlined">delete</span> Remove</button><button class="text-button"><span class="material-symbols-outlined">favorite</span> Move to wishlist</button></div></div></div></article>
    }
  }
  <div class="cart-note"><span class="material-symbols-outlined">volunteer_activism</span><div><b>You are supporting independent makers</b><small>Every order helps preserve a living craft tradition.</small></div></div>
}

templ CheckoutItems(items []viewmodels.CartItem) {
  for _, item := range items {
    <div class="checkout-item"><img src={ item.Product.ImageURL } alt=""/><div><b>{ item.Product.Seller }</b><p>{ item.Product.Name } | Qty: { item.Quantity } | { item.Product.Price }</p><small><span class="material-symbols-outlined">local_shipping</span> Standard delivery: { item.Delivery }</small></div></div>
  }
}

templ CheckoutSummaryItems(items []viewmodels.CartItem) {
  for _, item := range items {
    <p><span>{ item.Product.Name } <small>x { item.Quantity }</small></span><b>{ item.Product.Price }</b></p>
  }
}

templ Home(p viewmodels.CustomerPage) {
  @Document(p) {
    <section class="hero container"><div class="hero-copy"><p class="eyebrow">HANDCRAFTED. ROOTED IN INDIA.</p><h1>Indian arts, crafts<br/>and sarees for a<br/><em>more beautiful tomorrow</em></h1><p>Discover authentic handmade creations from Indian artisans. Timeless traditions. Modern homes. A kinder world.</p><a class="primary-button" href="/categories">Shop our collections <span class="material-symbols-outlined">arrow_forward</span></a><div class="hero-proof"><span><b>01</b> Handmade with love</span><span><b>02</b> Made in India</span><span><b>03</b> Supports 10,000+ artisans</span></div></div><div class="hero-image"><img src="/assets/images/customer/hero-studio.png" alt="Indian artisan working in a craft studio"/><span class="hero-note">Traditions<br/>live on<br/><b>here</b> <span class="material-symbols-outlined">arrow_forward</span></span></div><aside class="hero-aside"><span>More than products.<br/><b>Brighter futures.</b></span><i>+</i></aside></section>
    <section class="container category-rail home-rail"><a class="category-card" href="/products?category=arts"><img src="/assets/images/customer/madhubani-tree.png" alt="Madhubani painting"/><span><strong>Arts</strong><small>Paintings, sculptures, traditional art &amp; more</small><b>Explore Arts <span class="material-symbols-outlined">arrow_forward</span></b></span></a><a class="category-card" href="/products?category=crafts"><img src="/assets/images/customer/wooden-box.png" alt="Carved wooden jewellery box"/><span><strong>Crafts</strong><small>Home decor, handicrafts, lifestyle &amp; gifts</small><b>Explore Crafts <span class="material-symbols-outlined">arrow_forward</span></b></span></a><a class="category-card" href="/products?category=sarees"><img src="/assets/images/customer/saree-maroon.png" alt="Handwoven maroon saree"/><span><strong>Sarees</strong><small>Handloom, heritage &amp; contemporary</small><b>Explore Sarees <span class="material-symbols-outlined">arrow_forward</span></b></span></a></section>
    <section class="container offers-rail"><div><span class="offer-icon">%</span><b>Festive offers<br/><strong>Up to 40% off</strong></b><small>Celebrate handmade this season</small></div><div><span class="offer-icon"><span class="material-symbols-outlined">local_shipping</span></span><b>Free shipping<br/><strong>On orders INR 999+</strong></b><small>Across India &amp; beyond</small></div><div><span class="offer-icon"><span class="material-symbols-outlined">favorite</span></span><b>Made with love<br/><strong>From our makers</strong></b><small>Every purchase makes a difference</small></div></section>
    <section class="container section">
        @SectionHeading("THE GOOD STUFF", "Trending now", "Beautiful things, made slowly and thoughtfully.")<div class="product-grid product-grid--six">
        @ProductCards(p.Products[:6], true)</div></section>
    <section class="container section">
        @SectionHeading("MEET THE MAKERS", "Stories behind the craft", "The hands, homes and heritage behind every piece.")<div class="seller-grid">@SellerCards(p.Sellers)</div></section>
    <section class="maker-banner container"><div><p class="eyebrow">A LITTLE MORE HUMAN</p><h2>When you buy handmade,<br/><em>you help a story continue.</em></h2><p>Every order supports an independent maker, keeps a living tradition in motion and makes room for the next generation to create.</p><a class="outline-button" href="/makers/mithila-arts">Meet our makers <span class="material-symbols-outlined">arrow_forward</span></a></div><img src="/assets/images/customer/maker-mithila.png" alt="Madhubani artisan in her studio"/></section>
    <section class="container section collection-section">
        @SectionHeading("CURATED FOR YOU", "Find your kind of beautiful", "Collections with a little more meaning.")<div class="collection-grid"><a class="collection-card collection-card--large" href="/products?category=sarees"><img src="/assets/images/customer/saree-blue.png" alt="Handloom saree"/><span><small>For every occasion</small><strong>The saree edit</strong><b>Shop handlooms <span class="material-symbols-outlined">arrow_forward</span></b></span></a><a class="collection-card" href="/products?category=home-living"><img src="/assets/images/customer/terracotta-planter.png" alt="Terracotta planter"/><span><small>For your home</small><strong>Earth &amp; object</strong><b>Explore <span class="material-symbols-outlined">arrow_forward</span></b></span></a><a class="collection-card" href="/products?category=gifts"><img src="/assets/images/customer/terracotta-lamp.png" alt="Terracotta diyas"/><span><small>For giving</small><strong>Thoughtful gifts</strong><b>Find a gift <span class="material-symbols-outlined">arrow_forward</span></b></span></a></div></section>
    <section class="world-strip container"><div><span class="material-symbols-outlined">public</span><h2>From India, to the world</h2><p>Authentic craft, carefully packed and sent wherever home is.</p><a href="/products">Explore global favourites <span class="material-symbols-outlined">arrow_forward</span></a></div><img src="/assets/images/customer/blue-tote.png" alt="Ikat tote bag"/><img src="/assets/images/customer/madhubani-tree.png" alt="Madhubani painting"/></section>
  }
}

templ Categories(p viewmodels.CustomerPage) {
  @Document(p) {
    <section class="container page-intro categories-intro">
        @Breadcrumb("Home", "Categories")<p class="eyebrow">TAKE YOUR TIME</p><h1>Explore all categories</h1><p>From heirloom weaves to objects for everyday living, find something made with intention.</p></section>
    <section class="container category-layout"><aside class="category-sidebar"><h2>Browse by craft</h2><a class="active" href="/categories">All categories <span>12</span></a><a href="/products?category=arts">Arts <span>148</span></a><a href="/products?category=crafts">Crafts <span>326</span></a><a href="/products?category=sarees">Sarees <span>214</span></a><a href="/products?category=home-living">Home &amp; Living <span>198</span></a><a href="/products?category=fashion">Fashion &amp; Accessories <span>176</span></a><a href="/products?category=gifts">Gifts &amp; Occasions <span>134</span></a><div class="sidebar-note"><span class="material-symbols-outlined">volunteer_activism</span><b>Every purchase supports an artisan</b><small>Shop with purpose, keep traditions alive.</small></div></aside><div class="category-content"><div class="category-feature"><img src="/assets/images/customer/maker-mithila.png" alt="Madhubani artisan painting"/><div><p class="eyebrow">THE WEEVCRAFTS DIFFERENCE</p><h2>Beautiful by nature.<br/><em>Meaningful by design.</em></h2><p>Small-batch pieces from verified makers across India, with the story always kept close.</p><a class="primary-button" href="/makers/mithila-arts">Meet the makers <span class="material-symbols-outlined">arrow_forward</span></a></div></div><div class="category-card-grid">@CategoryCards(p.Categories)</div><section class="subcategories"><div class="subcat-panel"><p class="eyebrow">START HERE</p><h2>Shop by craft</h2><div class="subcat-links"><a href="/products?category=arts"><b>Madhubani painting</b><small>Folk art with a story</small></a><a href="/products?category=crafts"><b>Brass &amp; metalwork</b><small>Objects that last</small></a><a href="/products?category=sarees"><b>Handloom sarees</b><small>Woven with patience</small></a><a href="/products?category=home-living"><b>Pottery &amp; ceramics</b><small>Earthy everyday pieces</small></a></div></div><div class="subcat-panel subcat-panel--dark"><p class="eyebrow">OCCASION EDIT</p><h2>Gifts that feel personal</h2><p>For new homes, new beginnings and every little celebration in between.</p><a class="text-link inverse-link" href="/products?category=gifts">Shop gifting <span class="material-symbols-outlined">arrow_forward</span></a></div></section></div></section>
    <section class="container section category-collections">
        @SectionHeading("CURATED EDITS", "A considered collection", "Thoughtful picks for the people and spaces you love.")<div class="collection-grid"><a class="collection-card" href="/products?category=home-living"><img src="/assets/images/customer/wooden-box.png" alt="Wooden jewellery box"/><span><small>Slow living</small><strong>Little luxuries</strong><b>Explore <span class="material-symbols-outlined">arrow_forward</span></b></span></a><a class="collection-card collection-card--large" href="/products?category=fashion"><img src="/assets/images/customer/blue-tote.png" alt="Ikat tote bag"/><span><small>Made to move with you</small><strong>Everyday craft</strong><b>Shop the edit <span class="material-symbols-outlined">arrow_forward</span></b></span></a><a class="collection-card" href="/products?category=gifts"><img src="/assets/images/customer/terracotta-lamp.png" alt="Terracotta lamps"/><span><small>Festive favourites</small><strong>Gifts with a soul</strong><b>Find a gift <span class="material-symbols-outlined">arrow_forward</span></b></span></a></div></section>
  }
}

templ Listing(p viewmodels.CustomerPage) {
  @Document(p) {
    <section class="container page-intro listing-intro">
        @Breadcrumb("Home", "Search results")<p class="eyebrow">TAKE A CLOSER LOOK</p><h1>Handloom sarees</h1><p>Timeless weaves, contemporary colours and the stories of the people who make them.</p></section>
    <section class="container listing-layout"><aside class="filter-sidebar"><div class="filter-head"><h2>Filter by</h2><a href="/search">Clear all</a></div><details open><summary>Categories <span class="material-symbols-outlined">expand_less</span></summary><label><input type="checkbox" checked/> Sarees <span>(214)</span></label><label><input type="checkbox"/> Handloom <span>(98)</span></label><label><input type="checkbox"/> Silk cotton <span>(72)</span></label><label><input type="checkbox"/> Chanderi <span>(44)</span></label></details><details open><summary>Price <span class="material-symbols-outlined">expand_less</span></summary><label><input type="radio" name="price"/> Under INR 1,000</label><label><input type="radio" name="price"/> INR 1,000 - 2,500</label><label><input type="radio" name="price"/> INR 2,500 - 5,000</label><label><input type="radio" name="price"/> Above INR 5,000</label></details><details open><summary>Customer rating <span class="material-symbols-outlined">expand_less</span></summary><label><input type="checkbox"/> 4.5 and above</label><label><input type="checkbox"/> 4.0 and above</label></details><details open><summary>Availability <span class="material-symbols-outlined">expand_less</span></summary><label><input type="checkbox" checked/> In stock <span>(1,196)</span></label></details><details open><summary>Seller location <span class="material-symbols-outlined">expand_less</span></summary><label><input type="checkbox"/> Madhya Pradesh</label><label><input type="checkbox"/> Bihar</label><label><input type="checkbox"/> Rajasthan</label></details></aside><div class="listing-results"><div class="results-toolbar"><div><b>{ len(p.Products) } results</b><span class="filter-chips"><button type="button">Handloom sarees <span>×</span></button><button type="button">In stock <span>×</span></button></span></div><label>Sort by <select name="sort" hx-get="/search" hx-select="#page" hx-target="#page"><option>Relevance</option><option>Price: Low to High</option><option>Newest</option></select></label></div><div class="listing-banner"><div><p class="eyebrow">THE HANDLOOM EDIT</p><h2>Woven slowly.<br/><em>Worn forever.</em></h2><p>Meet the weavers keeping India's most beautiful textiles in motion.</p><a href="/makers/mithila-arts">Explore the stories <span class="material-symbols-outlined">arrow_forward</span></a></div><img src="/assets/images/customer/saree-blue.png" alt="Blue handloom saree"/></div><div class="product-grid product-grid--four">
        @ListingProducts(p.Products)</div><nav class="pagination" aria-label="Pagination"><a href="#"><span class="material-symbols-outlined">chevron_left</span></a><a class="active" href="#">1</a><a href="#">2</a><a href="#">3</a><span>...</span><a href="#">104</a><a href="#"><span class="material-symbols-outlined">chevron_right</span></a></nav></div></section>
    <section class="container international-banner"><div><span class="material-symbols-outlined">public</span><div><p class="eyebrow">INDIAN CRAFT, EVERYWHERE</p><h2>We ship globally</h2><p>Carefully packed, lovingly sent. Your next heirloom is closer than you think.</p></div></div><a class="outline-button" href="/products">Shop global favourites <span class="material-symbols-outlined">arrow_forward</span></a></section>
  }
}

templ ProductDetail(p viewmodels.CustomerPage) {
  @Document(p) {
    <section class="container product-detail">
        @Breadcrumb("Home", "Sarees", "Chanderi Silk Cotton Saree")<div class="detail-grid"><div class="gallery" x-data="{active:0}"><div class="thumbs"><button type="button" @click="active=0"><img src="/assets/images/customer/saree-maroon.png" alt="Maroon saree"/></button><button type="button" @click="active=1"><img src="/assets/images/customer/saree-blue.png" alt="Blue saree"/></button><button type="button" @click="active=2"><img src="/assets/images/customer/maker-mithila.png" alt="Maker story"/></button></div><div class="gallery-main"><img x-show="active===0" src="/assets/images/customer/saree-maroon.png" alt="Chanderi Silk Cotton Saree - Royal Maroon"/><img x-show="active===1" x-cloak src="/assets/images/customer/saree-blue.png" alt="Chanderi Silk Cotton Saree - Royal Maroon"/><img x-show="active===2" x-cloak src="/assets/images/customer/maker-mithila.png" alt="Chanderi artisan"/><button class="gallery-heart" type="button" aria-label="Add to wishlist"><span class="material-symbols-outlined">favorite</span></button></div><small class="gallery-caption">Handwoven in Maheshwar, Madhya Pradesh</small></div><div class="detail-copy"><span class="badge">Bestseller</span><h1>Chanderi Silk Cotton Saree - Royal Maroon</h1><p class="lead">A timeless weave of elegance and tradition</p><div class="stars"><span class="material-symbols-outlined">star</span><span class="material-symbols-outlined">star</span><span class="material-symbols-outlined">star</span><span class="material-symbols-outlined">star</span><span class="material-symbols-outlined">star</span> <span>4.8 (218 reviews)</span></div><a class="seller-line" href="/makers/mithila-arts"><img src="/assets/images/customer/maker-mithila.png" alt="Weaver's Touch"/><span>By Weaver's Touch<small><span class="material-symbols-outlined">location_on</span> Maheshwar, Madhya Pradesh</small></span><span class="material-symbols-outlined">chevron_right</span></a><div class="detail-price">INR 5,999 <del>INR 7,999</del> <mark>25% OFF</mark></div><p class="tax-note">Inclusive of all taxes</p><p class="description">Lightweight, elegant and effortlessly graceful, this handwoven Chanderi saree blends the richness of silk with the comfort of cotton. A beautiful choice for festive occasions and special gatherings.</p><fieldset><legend>Color: <b>Royal Maroon</b></legend><button class="swatch maroon" aria-label="Royal Maroon"></button><button class="swatch green" aria-label="Forest Green"></button><button class="swatch blue" aria-label="Peacock Blue"></button></fieldset><div class="quantity-row"><label>Quantity <span class="quantity-control"><button type="button">-</button><output>1</output><button type="button">+</button></span></label><span class="stock"><span class="material-symbols-outlined">check_circle</span> In stock <small>Only 3 left</small></span></div><div class="detail-actions"><button class="outline-button" hx-post="/ui/cart/chanderi-royal" hx-select="#page" hx-target="#page"><span class="material-symbols-outlined">shopping_bag</span> Add to cart</button><button class="primary-button" hx-post="/ui/cart/chanderi-royal" hx-select="#cart-count" hx-target="#cart-count"><span class="material-symbols-outlined">bolt</span> Buy now</button></div><form class="pincode"><span class="material-symbols-outlined">location_on</span><input placeholder="Enter pincode" aria-label="Pincode"/><button type="button">Check</button></form><div class="benefits"><span><span class="material-symbols-outlined">local_shipping</span><b>Estimated delivery</b><small>4 - 6 days</small></span><span><span class="material-symbols-outlined">autorenew</span><b>Easy returns</b><small>Within 7 days</small></span><span><span class="material-symbols-outlined">verified_user</span><b>Secure payments</b><small>100% safe and trusted</small></span><span><span class="material-symbols-outlined">public</span><b>International shipping</b><small>To 50+ countries</small></span></div></div></div><section class="detail-tabs" x-data="{tab:'description'}"><nav><button class="active" @click="tab='description'">Product description</button><button @click="tab='specs'">Specifications</button><button @click="tab='story'">Maker story</button><button @click="tab='reviews'">Reviews (218)</button></nav><div x-show="tab==='description'"><p>This exquisite Chanderi Silk Cotton saree is a celebration of India's rich handloom heritage. Woven by skilled artisans in Maheshwar, it features delicate zari butis across the body and a rich traditional border.</p><ul><li>Handwoven by skilled artisans</li><li>Lightweight, breathable and easy to drape</li><li>Perfect for festive and special occasions</li></ul></div><div x-show="tab==='specs'" x-cloak><div class="spec-grid"><span>Fabric <b>Chanderi silk cotton</b></span><span>Color <b>Royal maroon</b></span><span>Weave <b>Handloom</b></span><span>Care <b>Dry clean only</b></span></div></div><div x-show="tab==='story'" x-cloak><p>Weaver's Touch keeps Maheshwar's traditional techniques alive for contemporary homes, working directly with independent weaving families.</p></div><div x-show="tab==='reviews'" x-cloak><div class="review-highlight"><strong>4.8</strong><span>Excellent<br/>218 verified reviews</span></div><p>"The colour is even more beautiful in person. Such a light, comfortable weave." - Verified customer</p></div></section></section><section class="container section">
        @SectionHeading("YOU MAY ALSO LIKE", "More made-for-you finds", "Keep exploring the beautiful things our makers make.")<div class="product-grid product-grid--four">
        @ProductCards(p.Products[3:7], true)</div></section><section class="container seller-callout"><img src="/assets/images/customer/maker-mithila.png" alt="Weaver's Touch"/><div><p class="eyebrow">THE MAKER BEHIND THE PIECE</p><h2>Meet Weaver's Touch</h2><p>Traditional handlooms for a brighter, more thoughtful wardrobe. Based in Maheshwar, Madhya Pradesh.</p><a class="text-link" href="/makers/mithila-arts">Visit the maker store <span class="material-symbols-outlined">arrow_forward</span></a></div></section>
  }
}

templ SellerStore(p viewmodels.CustomerPage) {
  @Document(p) {
    <section class="seller-hero"><img src="/assets/images/customer/maker-mithila.png" alt="Mithila Arts studio"/><div class="container"><p class="eyebrow">A WEEVCRAFTS MAKER</p><h1>Mithila Arts</h1><p>Hand-painted stories from Bihar</p></div></section><section class="container seller-profile"><div class="seller-avatar"><img src="/assets/images/customer/maker-mithila.png" alt="Mithila Arts"/></div><div><h2>Mithila Arts <span class="verified"><span class="material-symbols-outlined">verified</span></span></h2><p>Hand-painted stories from Bihar</p><div class="stars"><span class="material-symbols-outlined">star</span> 4.8 <small>(124 reviews) | Madhubani, Bihar | On WeeVCrafts since 2021</small></div><p class="seller-description">Mithila Arts brings the rich tradition of Madhubani painting to your home. Every piece is hand-painted by rural women artisans from Bihar, keeping centuries-old stories and culture alive.</p></div><div class="seller-actions"><button class="primary-button"><span class="material-symbols-outlined">favorite</span> Follow store</button><button class="outline-button"><span class="material-symbols-outlined">share</span> Share store</button></div></section><section class="container seller-stats"><span><b>120+</b><small>Products</small></span><span><b>4.8 / 5</b><small>Store rating</small></span><span><b>98%</b><small>Happy customers</small></span><span><b>3 years</b><small>On WeeVCrafts</small></span></section><section class="container seller-tabs"><nav><a class="active" href="#products">All products</a><a href="#new">New arrivals</a><a href="#best">Best sellers</a><a href="#about">About the maker</a><a href="#reviews">Reviews</a><a href="#policies">Policies</a></nav><div class="section-head"><div><p class="eyebrow">FROM THE STUDIO</p><h2>Products by Mithila Arts</h2></div><label>Sort by <select><option>Featured</option><option>Newest</option><option>Price</option></select></label></div><div class="product-grid product-grid--five">
        @ProductCards(p.Products[:5], false)</div></section><section class="container maker-about" id="about"><div><p class="eyebrow">THE MAKER STORY</p><h2>Painted with patience,<br/><em>carrying a whole world.</em></h2><p>Madhubani painting began as a ritual on the walls and floors of homes in Bihar. Today, Mithila Arts keeps those stories moving, one hand-painted panel at a time.</p><a class="text-link" href="#reviews">Read customer stories <span class="material-symbols-outlined">arrow_forward</span></a></div><div class="why-shop"><h3>Why shop from Mithila Arts?</h3><span><span class="material-symbols-outlined">draw</span><b>Made by hand</b><small>Each piece has its own character.</small></span><span><span class="material-symbols-outlined">volunteer_activism</span><b>Fair maker partnership</b><small>Your purchase directly supports the studio.</small></span><span><span class="material-symbols-outlined">package_2</span><b>Carefully packed</b><small>Ready to gift, wherever it is going.</small></span></div></section>
  }
}

templ SavedProduct(product viewmodels.Product) {
  <article class="saved-card"><div class="saved-media"><img src={ product.ImageURL } alt={ product.Name }/><button class="heart" type="button" hx-post={ "/ui/wishlist/" + product.Slug } hx-target="closest article" hx-swap="outerHTML" aria-label="Remove from wishlist"><span class="material-symbols-outlined">favorite</span></button></div><div class="saved-copy"><span class="badge">{ product.Badge }</span><h3><a href={ "/products/" + product.Slug }>{ product.Name }</a></h3><p>By { product.Seller }</p><div class="rating"><span class="material-symbols-outlined">star</span> { product.Rating } ({ product.Reviews })</div><div class="price"><strong>{ product.Price }</strong><del>{ product.CompareAt }</del></div><small class="availability"><span class="material-symbols-outlined">check_circle</span> In stock</small><div><button class="primary-button" hx-post={ "/ui/cart/" + product.Slug } hx-select="#page" hx-target="#page"><span class="material-symbols-outlined">shopping_bag</span> Move to cart</button><button class="text-button" hx-post={ "/ui/wishlist/" + product.Slug } hx-target="closest article" hx-swap="outerHTML">Remove</button></div></div></article>
}

templ Wishlist(p viewmodels.CustomerPage) {
  @Document(p) {
    <section class="container page-intro wishlist-intro">
        @Breadcrumb("Home", "My Wishlist")<p class="eyebrow">SAVED WITH LOVE</p><h1>My wishlist</h1><p>Handpicked with love, for a more beautiful tomorrow.</p><p>Your saved treasures from India's finest artisans. Keep them close, move to cart when you are ready.</p></section><section class="container section"><div class="section-head"><div><h2>{ p.WishlistCount } items in your wishlist</h2><p>These are the pieces you chose to keep an eye on.</p></div><a class="outline-button" href="/products">Continue shopping <span class="material-symbols-outlined">arrow_forward</span></a></div><div class="saved-grid">
        @SavedProducts(p.Products[:6])</div></section><section class="container section wishlist-recommendations">
        @SectionHeading("KEEP DISCOVERING", "You may also love", "More beautiful finds from independent makers.")<div class="product-grid product-grid--six">
        @ProductCards(p.Products[6:], true)</div></section>
  }
}

templ AccountSidebar(active string) {
  <aside class="account-sidebar">
    <div class="profile-mini"><div class="avatar">AS</div><b>Ananya Sharma</b><small>ananya.sharma@gmail.com</small></div>
    if active == "account" {
      <a class="active" href="/account"><span class="material-symbols-outlined">dashboard</span> My account</a>
    } else {
      <a href="/account"><span class="material-symbols-outlined">dashboard</span> My account</a>
    }
    <a href="/account/profile"><span class="material-symbols-outlined">person</span> Profile</a><a href="/account/addresses"><span class="material-symbols-outlined">location_on</span> Addresses</a>
    if active == "orders" {
      <a class="active" href="/orders"><span class="material-symbols-outlined">inventory_2</span> Orders</a>
    } else {
      <a href="/orders"><span class="material-symbols-outlined">inventory_2</span> Orders</a>
    }
    <a href="/wishlist"><span class="material-symbols-outlined">favorite</span> Wishlist</a><a href="/account/notifications"><span class="material-symbols-outlined">notifications</span> Notifications</a><a href="/account/privacy"><span class="material-symbols-outlined">lock</span> Privacy</a><a href="/account/security"><span class="material-symbols-outlined">shield</span> Security</a><a href="/contact"><span class="material-symbols-outlined">support_agent</span> Support</a>
  </aside>
}

templ Orders(p viewmodels.CustomerPage) {
  @Document(p) {
    <section class="container page-intro account-intro">
        @Breadcrumb("Home", "My Account", "My Orders")<p class="eyebrow">YOUR WEEVCRAFTS JOURNEY</p><h1>My orders</h1><p>Track, manage and view your orders from WeeVCrafts.</p><nav class="tabs"><a class="active" href="/orders">All orders (12)</a><a href="#">Active (3)</a><a href="#">Delivered (7)</a><a href="#">Cancelled (2)</a></nav></section><section class="container account-layout">
        @AccountSidebar("orders")<div class="account-content orders-list"><article class="order-card"><header><div><p class="eyebrow">ORDER PLACED</p><h2>{ p.Orders[0].Number } <mark>{ p.Orders[0].Status }</mark></h2><small>{ p.Orders[0].Date } | { p.Orders[0].Payment }</small></div><div><b>3 items</b><strong>{ p.Orders[0].Total }</strong></div></header><div class="order-progress"><span class="done"><i>1</i><b>Order placed</b><small>26 Apr</small></span><span class="done"><i>2</i><b>Packed</b><small>27 Apr</small></span><span><i>3</i><b>Shipped</b><small>Awaiting update</small></span><span><i>4</i><b>Delivered</b><small>Awaiting update</small></span></div><div class="seller-order"><div class="seller-order-head"><b><span class="material-symbols-outlined">storefront</span> Weaver's Touch</b><span>Delivery expected 30 Apr - 02 May</span></div>
        @OrderRows(p.Orders[0].Items)</div><footer><a class="primary-button" href="/orders/%23WC2504267819">Track order <span class="material-symbols-outlined">arrow_forward</span></a><button class="outline-button">Cancel order</button><button class="outline-button">Need help?</button></footer></article><h2 class="order-history-title">Past orders</h2>
        @HistoryRows(p.Orders[1:])</div></section>
  }
}

templ Returns(p viewmodels.CustomerPage) {
  @Document(p) {
    <section class="container page-intro returns-intro">
        @Breadcrumb("Home", "My Account", "Returns and Refunds")<p class="eyebrow">WE HAVE GOT YOU</p><h1>Returns &amp; refunds</h1><p>We want you to love what you bring home. If something is not right, we are here to make it easy.</p></section><section class="container returns-layout"><div class="returns-main"><nav class="tabs"><a class="active" href="/returns">Active returns (2)</a><a href="#">Refunds (1)</a><a href="#">Closed requests (1)</a></nav><article class="return-card"><header><div><mark>{ p.Returns[0].Status }</mark><h2>Return request { p.Returns[0].ID }</h2></div><small>Requested { p.Returns[0].Requested }</small></header><div class="return-main"><img src={ p.Returns[0].ImageURL } alt={ p.Returns[0].ProductName }/><div><h2>{ p.Returns[0].ProductName }</h2><p>Order <b>{ p.Returns[0].OrderNumber }</b><br/>Sold by Weaver's Touch</p><strong>{ p.Returns[0].Amount }</strong></div><dl><dt>Return reason</dt><dd>{ p.Returns[0].Reason }</dd><dt>Pickup address</dt><dd>HSR Layout,<br/>Bengaluru, Karnataka</dd></dl></div><div class="return-status"><div><h3>Current status</h3><mark>Pickup scheduled</mark></div><p>Our logistics partner will pick up your item soon.</p><div class="status-box"><span class="material-symbols-outlined">local_shipping</span> Pickup scheduled for <b>15 Nov 2024, 10 AM - 6 PM</b></div></div><div class="return-progress"><span class="done"><i>1</i><b>Return requested</b></span><span class="done"><i>2</i><b>Seller reviewed</b></span><span class="done"><i>3</i><b>Pickup scheduled</b></span><span><i>4</i><b>Item received</b></span><span><i>5</i><b>Refund initiated</b></span><span><i>6</i><b>Refunded</b></span></div><footer><button class="outline-button">Download return label</button><button class="outline-button">Cancel return</button><a class="text-link" href="#support">Need help?</a></footer></article><article class="return-card compact-return"><header><div><mark>Under review</mark><h2>{ p.Returns[1].ProductName }</h2></div><strong>{ p.Returns[1].Amount }</strong></header><p>Request { p.Returns[1].ID } | { p.Returns[1].Reason }</p><a class="text-link" href="#">View request <span class="material-symbols-outlined">arrow_forward</span></a></article><article class="return-card compact-return"><header><div><mark class="success-mark">Refund completed</mark><h2>{ p.Returns[2].ProductName }</h2></div><strong>{ p.Returns[2].Amount }</strong></header><p>Refund sent to original payment method on 08 Nov 2024.</p><a class="text-link" href="#">View refund details <span class="material-symbols-outlined">arrow_forward</span></a></article></div><aside class="returns-aside"><div><span class="material-symbols-outlined">autorenew</span><h2>7-day return window</h2><p>You can request a return within 7 days of delivery.</p><a href="#">View return policy <span class="material-symbols-outlined">arrow_forward</span></a></div><div id="support"><span class="material-symbols-outlined">support_agent</span><h2>Need help?</h2><p>Our support team is here for you, Monday to Saturday.</p><a href="#">Chat with us <span class="material-symbols-outlined">arrow_forward</span></a></div></aside></section>
  }
}

templ Account(p viewmodels.CustomerPage) {
  @Document(p) {
    <section class="account-welcome"><div class="container"><p class="eyebrow">YOUR WEEVCRAFTS HOME</p><h1>Welcome back,<br/><em>Ananya!</em></h1><p>Glad to have you here. Together, we support artisans and keep traditions alive.</p></div><img src="/assets/images/customer/maker-mithila.png" alt="Artisan at work"/></section><section class="container account-layout">
        @AccountSidebar("account")<div class="account-content"><div class="account-stats"><span><span class="material-symbols-outlined">inventory_2</span><b>12</b><small>Orders placed</small></span><span><span class="material-symbols-outlined">favorite</span><b>8</b><small>Items in wishlist</small></span><span><span class="material-symbols-outlined">reviews</span><b>4</b><small>Reviews written</small></span><span><span class="material-symbols-outlined">volunteer_activism</span><b>Proud supporter</b><small>Indian artisans</small></span></div><div class="account-cards"><section id="profile"><h2>Profile information</h2><a href="#">Edit <span class="material-symbols-outlined">edit</span></a><p><b>Ananya Sharma</b><br/>ananya.sharma@gmail.com<br/>+91 98765 43210<br/><small>Member since 12 Mar 2023</small></p></section><section id="addresses"><h2>Saved addresses</h2><a href="#">Manage <span class="material-symbols-outlined">arrow_forward</span></a><p><b>Home <mark>Default</mark></b><br/>A-203, Green View Apartments<br/>Koramangala, Bengaluru<br/>Karnataka 560034</p></section><section><h2>Recent orders</h2><a href="/orders">View all <span class="material-symbols-outlined">arrow_forward</span></a><div class="mini-item"><img src={ p.Products[2].ImageURL } alt=""/><span>Chanderi Silk Cotton Saree<small>Order #WC789456</small><b>{ p.Products[2].Price }</b></span></div></section><section><h2>Returns &amp; refunds</h2><a href="/returns">View all <span class="material-symbols-outlined">arrow_forward</span></a><div class="mini-item"><img src={ p.Products[4].ImageURL } alt=""/><span>Handpainted Ceramic Mugs<small>Return requested</small><b>View status</b></span></div></section><section id="payments"><h2>Payment methods</h2><a href="#">Manage <span class="material-symbols-outlined">arrow_forward</span></a><p>Card ending in 4586 <mark>Default</mark><br/><small>Expires 08/2027</small></p></section><section id="preferences"><h2>Notification preferences</h2><a href="#">Manage <span class="material-symbols-outlined">arrow_forward</span></a><p>Order updates <b class="green">On</b><br/>Offers &amp; promotions <b class="green">On</b><br/>New arrivals <b class="green">On</b></p></section><section id="privacy"><h2>Privacy preferences</h2><a href="#">Manage <span class="material-symbols-outlined">arrow_forward</span></a><p>Personal data<br/>Communications<br/>Data &amp; privacy</p></section><section id="security"><h2>Security &amp; sessions</h2><a href="#">Manage <span class="material-symbols-outlined">arrow_forward</span></a><p>Password<br/>Two-factor authentication<br/>Active sessions</p></section><section class="account-wide"><h2>Reviews &amp; maker love</h2><p>You have helped independent makers grow. Leave a note on your recent purchases and make their day.</p><a class="text-link" href="/wishlist">Review your saved pieces <span class="material-symbols-outlined">arrow_forward</span></a></section><section class="account-wide account-help"><span class="material-symbols-outlined">support_agent</span><div><h2>Need a hand?</h2><p>Our customer care team is here for order, return and product questions.</p></div><a class="outline-button" href="#">Contact support</a></section></div></div></section>
  }
}

templ OrderDetail(p viewmodels.CustomerPage) {
  @Document(p) {
    <section class="container page-intro compact-intro">
      @Breadcrumb("Home", "My Account", "My Orders", "Order details")
      <p class="eyebrow">ORDER DETAILS</p>
      <h1>Order #WC2504267819</h1>
      <p>Placed on 26 Apr 2024, 10:24 AM</p>
    </section>
    <section class="container order-detail-layout">
      <div class="order-detail-main">
        <div class="order-detail-status"><mark>Processing</mark><h2>Your order is being prepared with care.</h2><p>We will notify you as soon as it ships.</p></div>
        @OrderDetailRows(p.Orders[0].Items)
      </div>
      <aside class="summary"><h2>Order summary</h2><p>Items ({ p.CartCount }) <b>INR 14,797</b></p><p>Shipping <b>INR 0</b></p><hr/><h3>Total amount <strong>INR 14,797</strong></h3><button class="outline-button full">View invoice</button><button class="outline-button full">Need help?</button></aside>
    </section>
  }
}

templ Empty(p viewmodels.CustomerPage) {
  @Document(p) {
    <section class="container empty-page"><span class="material-symbols-outlined">favorite</span><h1>{ p.Title }</h1><p>{ p.Notice }</p><a class="primary-button" href="/products">Browse products <span class="material-symbols-outlined">arrow_forward</span></a></section>
  }
}

templ Cart(p viewmodels.CustomerPage) {
  @Document(p) {
    <section class="container page-intro compact-intro">
        @Breadcrumb("Home", "Your Cart")<p class="eyebrow">ALMOST YOURS</p><h1>Your cart</h1><p>{ p.CartCount } items from independent Indian makers</p></section><section class="container cart-layout"><div class="cart-items">
        @CartRows(p.Cart)</div><aside class="summary cart-summary"><h2>Order summary</h2><p>Items ({ p.CartCount }) <b>INR 10,397</b></p><p>Delivery charges <b>INR 100</b></p><p class="discount">You saved <b>INR 2,100</b></p><hr/><h3>Total amount <strong>INR 10,497</strong></h3><form class="coupon"><input placeholder="Have a coupon?" aria-label="Coupon code"/><button type="button">Apply</button></form><a class="primary-button full" href="/checkout">Proceed to checkout <span class="material-symbols-outlined">arrow_forward</span></a><small class="secure-note"><span class="material-symbols-outlined">lock</span> Safe and secure checkout</small></aside></section><section class="container section">
        @SectionHeading("BEAUTIFUL EXTRAS", "You might also like", "Complete your cart with something made with care.")<div class="product-grid product-grid--four">
        @ProductCards(p.Products[6:10], true)</div></section>
  }
}

templ Checkout(p viewmodels.CustomerPage) {
  @Document(p) {
    <section class="container page-intro checkout-intro">
        @Breadcrumb("Home", "Checkout")<p class="eyebrow">A SIMPLE, SECURE CHECKOUT</p><h1>Checkout</h1><p>One step closer to bringing home something beautiful.</p><div class="steps"><span class="active"><i>1</i><b>Address</b></span><i></i><span class="active"><i>2</i><b>Delivery</b></span><i></i><span><i>3</i><b>Payment</b></span><i></i><span><i>4</i><b>Review</b></span></div></section><section class="container checkout-layout"><div class="checkout-main"><section class="checkout-card"><header><h2><span>1</span> Delivery address</h2><a href="#">Add new</a></header><div class="address selected"><b><span class="material-symbols-outlined">check_circle</span> Priya Sharma <mark>Default</mark></b><p>#102, Green View Apartments<br/>Koramangala, Bengaluru - 560034<br/><small>+91 98765 43210</small></p><a href="#">Edit</a></div><div class="address"><b><span class="material-symbols-outlined">radio_button_unchecked</span> Office</b><p>WeeVCrafts Studio, Indiranagar<br/>Bengaluru - 560038</p><a href="#">Select</a></div></section><section class="checkout-card"><header><h2><span>2</span> Delivery &amp; order details</h2><span class="muted">3 items from 3 sellers</span></header>
        @CheckoutItems(p.Cart)</section><section class="checkout-card"><header><h2><span>3</span> Payment method</h2><span class="muted">100% secure</span></header><nav class="payment-methods"><button class="active"><span class="material-symbols-outlined">account_balance</span> UPI</button><button><span class="material-symbols-outlined">credit_card</span> Credit / debit card</button><button><span class="material-symbols-outlined">account_balance_wallet</span> Netbanking</button><button><span class="material-symbols-outlined">payments</span> Cash on delivery</button></nav><label class="field-label" for="upi">Enter UPI ID</label><input id="upi" class="wide-input" placeholder="name@upi"/><button class="primary-button full" hx-post="/ui/checkout" hx-target="#page">Continue to review <span class="material-symbols-outlined">arrow_forward</span></button></section></div><aside class="summary checkout-summary"><h2>Order summary ({ p.CartCount } items)</h2><div class="summary-items">
        @CheckoutSummaryItems(p.Cart)</div><p>Subtotal <b>INR 9,797</b></p><p>Shipping <b>INR 198</b></p><p class="discount">Discount <b>- INR 0</b></p><hr/><h3>Total payable <strong>INR 9,995</strong></h3><form class="coupon"><input placeholder="Coupon code"/><button type="button">Apply</button></form><button class="primary-button full" hx-post="/ui/checkout" hx-target="#page">Place order <span class="material-symbols-outlined">arrow_forward</span></button><small>Preview only. No payment will be attempted.</small></aside></section>
  }
}
